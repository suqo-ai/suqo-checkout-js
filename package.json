{
  "name": "suqo-js-checkout",
  "version": "0.1.0",
  "private": true,
  "description": "Drop-in JS loader that opens the SUQO checkout in a modal iframe on a merchant's site",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-to-frontend.mjs",
    "sync:check": "node scripts/sync-to-frontend.mjs --check",
    "check": "node --check public/suqo-checkout.js && echo 'suqo-checkout.js parses'",
    "demo": "python3 -m http.server 4500"
  }
}
